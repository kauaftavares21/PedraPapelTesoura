<?xml version="1.0" encoding="utf-8"?>
<!-- Layout em modo paisagem: duas colunas (placar e opções | arena e resultado) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <!-- Título -->
                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/titulo"
                    android:textColor="@color/texto_principal"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Placar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoRotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/jogador" />

                        <TextView
                            android:id="@+id/tvPontosJogador"
                            style="@style/TextoPontos"
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_caixa_placar"
                            android:gravity="center"
                            android:paddingVertical="6dp"
                            android:text="0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoRotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/computador" />

                        <TextView
                            android:id="@+id/tvPontosComputador"
                            style="@style/TextoPontos"
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_caixa_placar"
                            android:gravity="center"
                            android:paddingVertical="6dp"
                            android:text="0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Botões de jogada -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnPedra"
                            style="@style/BotaoOpcao"
                            android:contentDescription="@string/pedra"
                            android:src="@drawable/ic_pedra" />

                        <TextView
                            style="@style/RotuloOpcao"
                            android:text="@string/pedra" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnPapel"
                            style="@style/BotaoOpcao"
                            android:contentDescription="@string/papel"
                            android:src="@drawable/ic_papel" />

                        <TextView
                            style="@style/RotuloOpcao"
                            android:text="@string/papel" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/btnTesoura"
                            style="@style/BotaoOpcao"
                            android:contentDescription="@string/tesoura"
                            android:src="@drawable/ic_tesoura" />

                        <TextView
                            style="@style/RotuloOpcao"
                            android:text="@string/tesoura" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <!-- Arena: jogada do jogador x jogada do computador -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_caixa_placar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivJogadaJogador"
                            android:layout_width="@dimen/tamanho_icone_arena"
                            android:layout_height="@dimen/tamanho_icone_arena"
                            android:contentDescription="@string/aguardando"
                            android:src="@drawable/ic_interrogacao" />

                        <TextView
                            style="@style/TextoRotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/voce" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/versus"
                        android:textColor="@color/texto_secundario"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivJogadaComputador"
                            android:layout_width="@dimen/tamanho_icone_arena"
                            android:layout_height="@dimen/tamanho_icone_arena"
                            android:contentDescription="@string/aguardando"
                            android:src="@drawable/ic_interrogacao" />

                        <TextView
                            style="@style/TextoRotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/computador" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Jogada do computador e resultado -->
                <TextView
                    android:id="@+id/tvJogadaComputador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/escolha_sua_jogada"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvResultado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />

                <!-- Ações -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNovaJogada"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/nova_jogada" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFinalizar"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/finalizar_jogo" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
</LinearLayout>
